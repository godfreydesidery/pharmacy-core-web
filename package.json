{
  "name": "pharmacy-core-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "serve:prod": "node scripts/serve-prod.mjs",
    "e2e": "playwright test",
    "e2e:headless": "playwright test --headed=false",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:reasons": "node scripts/api-reasons.mjs",
    "lint:dialogs": "node scripts/no-browser-dialogs.mjs",
    "a11y:contrast": "node scripts/contrast.mjs",
    "a11y:labels": "node scripts/a11y-labels.mjs --list",
    "a11y:axe": "ng test --watch=false --include src/app/axe.a11y.spec.ts"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@playwright/test": "^1.65.1",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "description": "Pharmacy Core web console (Angular 21)."
}
